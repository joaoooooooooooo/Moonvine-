{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@affectui": {
      "url": "https://www.affectui.com/r/{name}.json",
      "headers": {
        "Authorization": "Bearer ${AFFECTUI_TOKEN}"
      }
    },
    "@coss": "https://coss.com/ui/r/{name}.json",
    "@lucide-animated": "https://lucide-animated.com/r/{name}.json",
    "@efferd": "https://efferd.com/r/{style}/{name}.json",
    "@evilcharts": "https://evilcharts.com/r/{name}.json",
    "@beui": "https://beui.dev/r/{name}.json"
  }
}
